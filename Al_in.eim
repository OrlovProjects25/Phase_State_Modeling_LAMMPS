units           metal
atom_style      atomic
boundary        p p p

lattice         fcc 4.05
region          my_box block 0 4 0 4 -4 4 units lattice
region          bottom_block block 0 4 0 4 -4 -0.25 units lattice
region          top_block block 0 4 0 4 -0.25 4 units lattice

create_box      1 my_box
create_atoms    1 region my_box

group           group1 region bottom_block 
group           group2 region top_block

pair_style      eam/fs
pair_coeff      * * Al1.eam.fs Al

neighbor        0.3 bin
neigh_modify    delay 0

compute         temp_bottom group1 temp
compute         temp_top group2 temp

timestep        0.001
thermo          5000
thermo_style    custom step etotal press vol temp c_temp_bottom c_temp_top

variable Teq_top index 3000.0
variable Teq index ${Teq}
variable Seed index ${Seed}

velocity        all create ${Teq} ${Seed} dist gaussian rot yes

fix             fix_all all npt temp ${Teq} ${Teq} 0.1 iso 0.0 0.0 0.1

run 20000

unfix fix_all

fix fix_top group2 npt temp ${Teq_top} ${Teq_top} 0.1 iso 0 0 0.1
run 20000

unfix fix_top

fix             fix_env all npt temp ${Teq} ${Teq} 0.1 aniso 0.0 0.0 0.1 couple xy

variable Teq_bottom index ${Teq}

variable KEPerAtom equal ke/atoms
variable PEPerAtom equal pe/atoms

fix             data_output all print 1 "$(step) $(etotal) $(temp) ${KEPerAtom} ${PEPerAtom}" file temp${Teq_bottom}_${Teq_top}_pe.profile screen no

run             60000
