units           metal
atom_style      atomic
boundary        p p p
lattice         fcc 4.05
region          mybox block 0 4 0 4 -4 4 units lattice
create_box      1 mybox
create_atoms    1 region mybox
pair_style      eam/fs
pair_coeff      * * ../Al1.eam.fs Al
neighbor        0.3 bin
neigh_modify    delay 0
timestep        0.001
thermo          100
thermo_style    custom step etotal press vol temp
variable CurTemp index 400.0 450.0 500.0 550.0 600.0 650.0 700.0 750.0 1400.0 1450.0 1500.0 1550.0 1600.0 1650.0 1700.0 1800.0

shell rm -f thermo_average.csv
label myLoop
variable targetTemp equal ${CurTemp}
velocity        all create ${CurTemp} 43454 dist gaussian mom yes
fix             int all npt temp ${CurTemp} ${CurTemp} 0.1 iso 1.0 1.0 0.1
variable        PEPerAtom equal pe/atoms
variable        p equal press
variable        V equal vol
variable        T equal temp
variable        Nlines equal 10000
run             40000
fix AVG all ave/time 1 ${Nlines} 100000 v_T v_PEPerAtom ave running start ${Nlines} file temp_now.csv & file temp_now.csv mode scalar title1 "" title2 ""
run             60000
shell cat temp_now.csv >> thermo_average.csv
unfix           int
unfix           AVG 
next            CurTemp
jump SELF myLoop
